    given-names: "Harpreet S."
    orcid: "https://orcid.org/0009-0008-5397-7495"
repository-code: "https://github.com/hsiddhu2/agent-governance-loop"
license: Apache-2.0
keywords:
  - ai-agents
  - agent-governance
  - amazon-bedrock-agentcore
  - cedar
  - guardrails
  - opentelemetry
